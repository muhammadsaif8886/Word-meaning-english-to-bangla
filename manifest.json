{
  "manifest_version": 3,
  "name": "PDF Word Meaning (EN to BN)",
  "version": "1.4",
  "description": "Select any English word to see Bengali meaning in a popup.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file://*/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
